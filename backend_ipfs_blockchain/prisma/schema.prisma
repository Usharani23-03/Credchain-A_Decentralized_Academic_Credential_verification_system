generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  // Certificates issued/uploaded by this user
  documents Document[] @relation("UserDocuments")

  // Certificates belonging to this student
  studentDocuments Document[] @relation("StudentDocuments")

  verificationHistory VerificationHistory[] @relation("EmployerVerifications")

  // Notifications belonging to this user
  notifications Notification[]
}

model Document {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  certificateType String

  fileName String
  fileHash String @unique

  certificateId   String?
  verificationUrl String?

  issuedBy  String
  issueDate DateTime

  verificationStatus VerificationStatus @default(PENDING)

  blockchainTxId String?
  ipfsHash       String?
  sha512Hash     String? @unique

  uploadedAt DateTime @default(now())

  // University / issuer
  userId Int
  user   User @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)

  // Student who receives the certificate
  studentId Int?
  student   User? @relation("StudentDocuments", fields: [studentId], references: [id], onDelete: SetNull)

  verificationHistory VerificationHistory[]
}

model VerificationHistory {
  id Int @id @default(autoincrement())

  documentId Int
  employerId Int

  status VerificationStatus

  verifiedAt DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  employer User @relation("EmployerVerifications", fields: [employerId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  type      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum Role {
  STUDENT
  UNIVERSITY
  EMPLOYER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}